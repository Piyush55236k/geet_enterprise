{
  "name": "geet-enterprise",
  "version": "1.0.0",
  "description": "Geet Enterprise - Full Stack Finance, Capital, Lending & Expense ERP",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "build:client": "npm --prefix client run build",
    "copy:client": "node -e \"const fs=require('fs'); if(fs.existsSync('client/dist')){fs.cpSync('client/dist','server/public',{recursive:true,force:true});console.log('Synchronized client/dist to server/public');}\"",
    "build": "npm run build:client && npm run copy:client",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "postinstall": "npm --prefix server install --production"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.0.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.16.1"
  },
  "keywords": [
    "geet-enterprise",
    "erp",
    "finance",
    "lending",
    "loans"
  ],
  "author": "Geet Enterprise",
  "license": "ISC"
}
